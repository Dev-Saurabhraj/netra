# NETRA Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="NETRA"
API_V1_STR="/api/v1"
SECRET_KEY="netra_super_secret_jwt_key_change_in_production_for_security"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=netra_user
POSTGRES_PASSWORD=netra_password
POSTGRES_DB=netra_db
DATABASE_URL="postgresql+asyncpg://netra_user:netra_password@localhost:5432/netra_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Initial Admin Seed
FIRST_SUPERUSER_EMAIL="admin@netra.local"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# Network Discovery Settings
DEFAULT_SNMP_COMMUNITY="public"
DISCOVERY_CONCURRENCY_LIMIT=10
DISCOVERY_TIMEOUT_SECONDS=5

